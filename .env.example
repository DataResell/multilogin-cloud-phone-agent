# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — NEVER commit real credentials, tokens, or profile IDs.

# --- Multilogin auth (for the gateway API) -------------------------------
# Option A: email + password. The example signs in via POST /user/signin.
MLX_EMAIL=your@email.com
MLX_PASSWORD=your-password
# Password hashing is auto-detected: the tool tries plaintext, and on a
# credentials rejection (HTTP 400 or 401) it retries once with the MD5 hash and
# logs which worked. Set this only to force the hashed form (skip the plaintext try):
# MLX_HASH_PASSWORD=1

# Option B: paste a Bearer token instead of email/password (skips sign-in).
# In the Multilogin app: Workspace info -> "API token" (needs the API-token plan feature).
# MLX_TOKEN=

# --- Target phone --------------------------------------------------------
MOBILE_PROFILE_ID=<MOBILE_PROFILE_ID>

# --- Optional ------------------------------------------------------------
# MLX_BASE_URL=https://api.multilogin.com
# MLX_ADB_BIN=adb
